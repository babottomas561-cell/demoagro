# ============================================================
# LEMON BI - Variables de Entorno
# Copiar a .env y completar con valores reales
# ============================================================

# --- APP ---
APP_ENV=development
APP_SECRET_KEY=changeme-super-secret-key-32chars
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- BASE DE DATOS ---
# Para desarrollo local con SQLite.
# Se mantiene el nombre demoagro.db por compatibilidad local.
DATABASE_URL=sqlite:///./demoagro.db

# Para PostgreSQL (recomendado para producción).
# Los nombres demoagro/agro_user se mantienen por compatibilidad.
# DATABASE_URL=postgresql://agro_user:agro_pass@db:5432/demoagro

POSTGRES_DB=demoagro
POSTGRES_USER=agro_user
POSTGRES_PASSWORD=agro_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- REDIS (cache para APIs externas) ---
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=1800

# ============================================================
# APIs EXTERNAS - Datos REALES
# ============================================================

# --- BCRA (Banco Central de la República Argentina) ---
# API pública, no requiere credenciales
# Docs: https://www.bcra.gob.ar/BCRAyVos/catalogo-de-APIs-banco-central.asp
BCRA_BASE_URL=https://api.bcra.gob.ar
BCRA_TIMEOUT=15
BCRA_CACHE_TTL=1800  # 30 min

# --- DATOS ARGENTINA / API de Series de Tiempo ---
# API pública, no requiere credenciales
# Docs: https://apis.datos.gob.ar/series/api/
DATOS_ARG_BASE_URL=https://apis.datos.gob.ar/series/api
DATOS_ARG_TIMEOUT=15
DATOS_ARG_CACHE_TTL=86400  # 24 hs

# --- OPEN-METEO (Clima - gratuito, sin API key) ---
# Docs: https://open-meteo.com/en/docs
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_CACHE_TTL=3600  # 1 hora

# --- USDA / PSD API ---
# Requiere registro gratuito en apps.fas.usda.gov
# Docs: https://apps.fas.usda.gov/psdonline/app/index.html#/app/apiDocs
USDA_API_KEY=your_usda_api_key_here
USDA_BASE_URL=https://apps.fas.usda.gov/psdonline/app
USDA_TIMEOUT=20
USDA_CACHE_TTL=86400  # 24 hs

# --- BOLSA DE COMERCIO DE ROSARIO (BCR) ---
# Si se obtienen credenciales, completar aquí
# Sin credenciales: modo degradado con datos de otras fuentes
BCR_API_KEY=your_bcr_api_key_here
BCR_BASE_URL=https://www.bcr.com.ar/es/mercados/granos/datos-de-mercados-api
BCR_TIMEOUT=15
BCR_CACHE_TTL=3600  # 1 hora

# --- MATBA-ROFEX (compatibilidad legacy) ---
# Requiere cuenta / credenciales
ROFEX_API_KEY=your_rofex_api_key_here
ROFEX_BASE_URL=https://api.remarkets.primary.com.ar
ROFEX_CACHE_TTL=1800

# --- COMMODITY PRICES (fallback público) ---
# Commodities World API u otras fuentes públicas
COMMODITIES_CACHE_TTL=3600

# --- JWT ---
JWT_SECRET_KEY=changeme-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Lemon BI
NEXT_PUBLIC_APP_VERSION=1.0.0
